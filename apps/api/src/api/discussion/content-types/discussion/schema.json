{
  "kind": "collectionType",
  "collectionName": "discussions",
  "info": {
    "singularName": "discussion",
    "pluralName": "discussions",
    "displayName": "Discussion"
  },
  "options": { "draftAndPublish": false },
  "attributes": {
    "referenceKey": { "type": "string", "unique": true },
    "trendRank": { "type": "integer", "default": 0 },
    "presentation": { "type": "json" },
    "title": { "type": "string", "required": true, "minLength": 10, "maxLength": 160 },
    "content": { "type": "text", "required": true, "maxLength": 20000 },
    "type": { "type": "enumeration", "enum": ["question", "discussion"], "required": true },
    "author": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "required": true
    },
    "category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::category.category",
      "inversedBy": "discussions",
      "required": true
    },
    "replies": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::reply.reply",
      "mappedBy": "discussion"
    }
  }
}
